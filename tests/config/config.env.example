# ─────────────────────────────────────────────────────────────────────────────
#  AIA test-suite configuration — copy to config.env and fill in.
#      cp tests/config/config.env.example tests/config/config.env
#  Every test script sources tests/config/config.env. NOTHING is hardcoded in the
#  scripts and nothing is read from anywhere else — this file is the single input.
#  config.env is .gitignored (see tests/.gitignore) so your values never get pushed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identities (the whole point of the 2-layer test is WHO runs WHAT) ────────────
# ADMIN profile — a workspace/account admin. Runs ONLY the one-time prereqs an admin
#   must do (create the role group + its data/warehouse access; job mode: create the
#   job SP and add it to the role group; grant the deployer servicePrincipal.user).
#   In production this is your platform/security admin. Here: your admin CLI profile.
ADMIN_PROFILE="your-admin-cli-profile"
# DEPLOYER profile — a REGULAR END USER (no account-admin). This is who we ship the code
#   to, so ALL deploy.sh / setup.sh / investigation steps run as this after prereqs.
#   In this sandbox we synthesize one: 00_admin_prereqs.sh creates a non-admin SP + OAuth
#   secret and writes a `<ADMIN_PROFILE>-deployer` profile into ~/.databrickscfg, then sets
#   DEPLOYER_PROFILE to it. Leave blank to auto-synthesize; or name a real regular-user profile.
DEPLOYER_PROFILE=""

# ── The AIA role (created by ADMIN in prereqs) ──
# A short suffix keeps every test artifact uniquely named + easy to grep/tear down.
TEST_SUFFIX="t1"                          # bump to run a clean parallel round
ROLE_GROUP="aia-test-role-${TEST_SUFFIX}"   # account-group display name (the RBAC role)
# ASSUME_GROUP (the role's account-group id) is DISCOVERED by 00_admin_prereqs.sh after it
# creates the group, and written back into config.env automatically. Leave blank.
# (in_process needs it for the app-SP Assume mint; job mode does not — membership.)
ASSUME_GROUP=""

# ── Bundle / workspace values (the config.yml the deployer would fill) ───────────
CATALOG="fevm_shared_catalog"             # a UC catalog the deployer can create schemas in
SCHEMA="ti_aia_test_${TEST_SUFFIX}"      # demo substrate + tools + the Postgres schema name
WAREHOUSE_ID=""                           # a SQL warehouse id (databricks warehouses list) — in_process only
LAKEBASE_PROJECT="aia-test-${TEST_SUFFIX}"
PG_DATABASE="aia_test_${TEST_SUFFIX}"    # the Postgres database name (created natively; no UC catalog)
APP_NAME="aia-test-app-${TEST_SUFFIX}"

# ── Mode under test ──────────────────────────────────────────────────────────────
# The suite runs BOTH modes; scripts that are mode-specific take the mode as $1.
# JOB mode needs a dedicated job SP that is a MEMBER of the role group (created + added by
# admin prereqs; discovered → written back). NO secret scope — membership needs no secret.
JOB_SP=""                                 # job SP application id (filled by 00_admin_prereqs.sh)

# ── LLM gateway (the agent's model) — AWS Secrets Manager via a UC service credential ────────────
# The endpoint URL is a PLAIN value; the TOKEN lives in AWS Secrets Manager, fetched at runtime via a UC
# SERVICE CREDENTIAL the app/job SP holds ACCESS on (lib/llm.py + docs/aws-secrets.md). No secret scope.
# One-time admin setup creates the AWS IAM role + secret + the UC service credential (see docs/aws-secrets.md).
AIA_LLM_ENDPOINT="databricks-claude-opus-5"      # existing serving endpoint (to derive the URL below)
AIA_LLM_ENDPOINT_URL=""                          # https://<host>/serving-endpoints/<name>/invocations
AIA_LLM_SERVICE_CREDENTIAL="aia-llm-aws-secrets" # the UC service credential name (wraps the AWS IAM role)
AIA_LLM_SECRET_ARN=""                            # AWS secret ARN — WRITTEN BACK by 00b_admin_aws_secret.sh
AIA_LLM_SECRET_REGION="us-west-2"
AIA_LLM_SECRET_JSON_KEY="token"                  # JSON key in the secret (empty = secret string IS the token)
# AWS provisioning inputs — used ONCE by 00b_admin_aws_secret.sh (shell must be authed: AWS_PROFILE + aws sso login)
AWS_PROFILE_FOR_SETUP=""                          # e.g. aws-sandbox-field-eng
AIA_LLM_SECRET_NAME="aia/llm-gateway-token"     # friendly Secrets Manager secret name
AIA_LLM_IAM_ROLE="aia-llm-secrets-access"       # IAM role name the UC credential assumes

# ── CI/CD only ─────────────────────────────────────────────────────────
# The CI service principal IS the deployer (DEPLOYER_PROFILE/DEPLOYER_SP, synthesized by 00_admin_prereqs) —
# there is no separate CI_SP to configure. Only the repo is Layer-2-specific.
GH_REPO=""                                # owner/name of the PERSONAL github repo (not a *_data org)
